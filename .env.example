# Copy to .env and fill in real values. Never commit .env.
#
# Safe to expose in the browser/frontend:
NEXT_PUBLIC_SUPABASE_URL=https://oebqicspbbjkguuvnnoz.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-side ONLY. Never prefix with NEXT_PUBLIC_, never import into
# frontend code, never commit. Bypasses Row Level Security.
SUPABASE_SECRET_KEY=

# Server-side ONLY. Free account at https://epc.opendatacommunities.org/
# Used by the EPC fallback lookup (backend/src/lookups/epc.ts).
EPC_API_EMAIL=
EPC_API_KEY=

# Server-side ONLY. ArcGIS FeatureServer query endpoint for DEFRA/UK-AIR AQMA
# boundaries, e.g. https://<host>/arcgis/rest/services/.../FeatureServer/0/query
# Used by the AQMA lookup (backend/src/lookups/aqma.ts).
AQMA_SERVICE_URL=
